{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [{ "path": "/api/compute/tick", "schedule": "* * * * *" }],
  "functions": {
    "api/compute/tick.ts": { "maxDuration": 60 },
    "api/compute/webhook.ts": { "maxDuration": 15 },
    "api/**/*.ts": { "maxDuration": 10 }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sqwaukie.si" }],
      "destination": "https://sqwakie.si/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sqwaukie.si" }],
      "destination": "https://sqwakie.si/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sqwakie.si" }],
      "destination": "https://sqwakie.si/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sqwaukie.si" }],
      "destination": "https://sqwakie.si/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sqwaukie.si" }],
      "destination": "https://sqwakie.si/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sqwakie.si" }],
      "destination": "https://sqwakie.si/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/m",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' wss://walkie-relay.fly.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/m/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' wss://walkie-relay.fly.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/m-sw.js",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' wss://walkie-relay.fly.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/join",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/join.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
