#!/bin/sh
# Seat tests' grok. `grok --version` is answered here so a policy probe (PATH=/usr/bin:/bin, no bun)
# can read it. A real seat launch execs the bun script beside this file and does not log the version probe.
if [ "$1" = "--version" ] || [ "$1" = "-V" ]; then
  printf '%s\n' "grok 1.0.46 (fixture)"
  exit 0
fi
script=$0
if [ -L "$script" ]; then
  target=$(readlink "$script") || exit 2
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
fi
exec bun "$(dirname "$script")/grok.ts" "$@"
