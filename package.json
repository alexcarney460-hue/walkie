{
  "name": "walkie",
  "version": "0.2.0-pre.10",
  "description": "Agent-to-agent network + live team dashboard, peer-to-peer (Walkie Direct) or over Tailscale",
  "type": "module",
  "bin": {
    "walkie": "src/cli/main.ts"
  },
  "scripts": {
    "walkie": "bun src/cli/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "web:dev": "cd web && bunx vite",
    "web:mock": "cd web && bun mock/server.ts",
    "web:build": "cd web && bunx vite build",
    "build": "bun run web:build && bun scripts/build.ts",
    "m:build": "bun build src/mobile/pwa/main.ts --outfile site/m/app.js --minify --target browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@number0/iroh": "1.1.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "license": "FSL-1.1-ALv2",
  "private": true
}
